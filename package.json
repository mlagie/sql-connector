{
  "name": "@mlagie/sql-connector",
  "version": "2.1.0",
  "description": "The sql-connector module allows you to manage connections to a MySQL database, define table schemas, and interact with data in a simple and efficient way.",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "src",
    "docs",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "test": "rm -r coverage ; node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:publish": "npm publish --dry-run",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "rm -r coverage ; node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "coverage:report": "node scripts/coverage-report.js",
    "security": "npx eslint . --max-warnings 0 --ignore-pattern './tests/*'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlagie/sql-connector.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "sql",
    "schema",
    "database",
    "orm",
    "model",
    "query",
    "connector",
    "mysql2",
    "sync",
    "migration",
    "builder",
    "pool",
    "mariadb",
    "rdbms"
  ],
  "author": "lagie-marin",
  "license": "MIT",
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "index.d.ts"
      ]
    }
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mlagie/sql-connector/issues"
  },
  "homepage": "https://github.com/mlagie/sql-connector#readme",
  "private": false,
  "dependencies": {
    "@mlagie/logger": "1.0.5",
    "mysql2": "3.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "jest": "30.4.2"
  },
  "overrides": {
    "test-exclude": "^8.0.0",
    "glob": "^13.0.6",
    "minimatch": "^10.2.2",
    "brace-expansion": "^5.0.9"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
